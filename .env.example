# Exemplo de configuracao local (NUNCA versionar o arquivo .env real)
SQLSERVER_HOST=localhost
SQLSERVER_DB=CacauAppBD
SQLSERVER_AUTH_MODE=integrated
# Em ambientes com SQL Login dedicado (Mixed Mode):
# SQLSERVER_IA_USER=usr_app_ia
# SQLSERVER_IA_PASSWORD=DEFINIR_SENHA_FORTE_FORA_DO_GIT

# Caminhos locais dos modelos proprietarios (bloqueados no .gitignore)
TFLITE_MODEL_PATH=app/src/main/assets/detector.tflite
DISEASE_MODEL_PATH=modeloia/best-doenca.pt
PIPELINE_CONFIG_VERSION=v2
